{
  "name": "angular-project",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-project": "node dist/angular-project/server/server.mjs",
    "lint": "ng lint",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s",
    "prepare": "husky"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.1.2",
    "@angular/compiler": "^20.1.2",
    "@angular/core": "^20.1.2",
    "@angular/forms": "^20.1.2",
    "@angular/platform-browser": "^20.1.2",
    "@angular/platform-server": "^20.1.2",
    "@angular/router": "^20.1.2",
    "@angular/ssr": "^20.1.1",
    "@ngrx/component": "^20.0.0-rc.0",
    "@ngrx/effects": "^20.0.0-rc.0",
    "@ngrx/operators": "^20.0.0-rc.0",
    "@ngrx/router-store": "^20.0.0-rc.0",
    "@ngrx/signals": "^20.0.0-rc.0",
    "@ngrx/store": "^20.0.0-rc.0",
    "@ngrx/store-devtools": "^20.0.0-rc.0",
    "@tailwindcss/postcss": "^4.1.11",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.1",
    "@angular/cli": "^20.1.1",
    "@angular/compiler-cli": "^20.1.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@compodoc/compodoc": "^1.1.26",
    "@eslint/js": "^9.31.0",
    "@ngrx/eslint-plugin": "^19.2.1",
    "@ngrx/schematics": "^20.0.0-rc.0",
    "@stylistic/eslint-plugin": "^5.1.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/parser": "^8.35.0",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-perfectionist": "^4.15.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.0.0",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
