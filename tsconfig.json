{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "baseUrl": "./",
    "downlevelIteration": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@helix/components/*": ["src/app/components/*"],
      "@helix/directives/*": ["src/app/directives/*"],
      "@helix/environments/*": ["src/environments/*"],
      "@helix/modules/*": ["src/app/modules/*"],
      "@helix/pipes/*": ["src/app/pipes/*"],
      "@helix/routing/*": ["src/app/routing/*"],
      "@helix/services/*": ["src/app/services/*"],
      "@helix/shared/*": ["src/app/shared/*"],
      "@helix/store/*": ["src/app/store/*"],
      "@helix/tokens/*": ["src/app/tokens/*"],
      "@helix/validators": ["src/app/validators"],
      "@helix/views/*": ["src/app/views/*"]
    },
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
