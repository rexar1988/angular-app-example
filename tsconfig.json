{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2024",
    "module": "preserve",
    "paths": {
      "@app/animations/*": ["src/app/animations/*"],
      "@app/components/*": ["src/app/components/*"],
      "@app/directives/*": ["src/app/directives/*"],
      "@app/environments/*": ["src/environments/*"],
      "@app/modules/*": ["src/app/modules/*"],
      "@app/pipes/*": ["src/app/pipes/*"],
      "@app/routing/*": ["src/app/routing/*"],
      "@app/services/*": ["src/app/services/*"],
      "@app/shared/*": ["src/app/shared/*"],
      "@app/states/*": ["src/app/states/*"],
      "@app/validators/*": ["src/app/validators/*"],
      "@app/views/*": ["src/app/views/*"],
      "test-ui": ["./projects/test-ui"],
      "test-ui/*": ["./projects/test-ui/*"]
    },
    "baseUrl": "./",
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/test-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/test-ui/tsconfig.spec.json"
    },
  ]
}
